            for i in T.Parallel(blk_m):
                scale[bx * blk_m + i, by] = s_local[i]
            T.copy(y_local, y_shared)
            T.copy(y_shared, quant[bx * blk_m, by * group_size], disable_tma=True)

    return quant, scale

